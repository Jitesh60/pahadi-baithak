  "lines": [
    {"text": "बेड़ु पाको बारो मासा, नरैण! काफल पाको चैता", "meaning": "The fig ripens all twelve months — the kafal only in Chaitra. The line every Kumaoni knows before they know why.", "src": "बेड़ु पाको बारो मासा"},
    {"text": "घुघुती ना बासा", "meaning": "Dove, don't call. She's asking the mountain dove to stop — its call is the sound of everyone who left for the plains.", "src": "गोपाल बाबू गोस्वामी"},
    {"text": "कैले बजें मुरूली ओ बैणा", "meaning": "Who is playing that flute, sister? Kumaon's most-covered opening line.", "src": "गोपाल बाबू गोस्वामी"},
    {"text": "हाय तेरी रुमाला, गुलाबी मुखड़ी", "meaning": "A song that praises a girl one garment and one ornament at a time — a whole wardrobe as a love letter.", "src": "लोकगीत"},
    {"text": "झन दिया बोज्यू छाना बिलौरी", "meaning": "Don't marry me into Chhana Bilauri, bhabhi. A bride naming the village she doesn't want to be sent to.", "src": "छाना बिलौरी"},
    {"text": "सुन ले दगड़िया", "meaning": "Listen, my companion. Pappu Karki, gone at 32, still the voice at every pahadi wedding.", "src": "पप्पू कार्की"},
    {"text": "पहाड़ो ठंडो पानी", "meaning": "The mountain's water runs cold. Kabutari Devi's is the voice older Kumaonis mean when they say they miss the radio.", "src": "कबूतरी देवी"},
    {"text": "शकुनाखर", "meaning": "The auspicious opening. Before any Kumaoni rite begins the women of the house sing this first — nothing starts until it is sung.", "src": "संस्कार गीत"},
    {"text": "जागर", "meaning": "A night-long sung invocation. The dhol calls, the singer recites the deity's story, and the god arrives in a human medium before dawn.", "src": "जागर परंपरा"},
    {"text": "सोनचड़ी", "meaning": "The golden bird of the Rajula–Malushahi ballad — a Katyuri prince, a Shauka trader's daughter, and a thousand years of bards carrying it village to village before anyone wrote it down.", "src": "राजुला–मालूशाही"}
  ]
}
