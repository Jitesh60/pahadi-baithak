# Copy to .env on the server and fill in. Never commit .env.

# A long random secret. Make one with:  openssl rand -base64 36
LIBRARY_TOKEN=

# The site(s) allowed to call this API, comma-separated
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:8080

# Cloudflare R2 — a PRIVATE bucket (no public r2.dev URL)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=pahadi-music
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# How long a play link works, in seconds (default 12 hours)
LINK_TTL_SECONDS=43200

# Optional: if YouTube asks the server to "confirm you're not a bot"
# YTDLP_COOKIES=/app/cookies.txt
